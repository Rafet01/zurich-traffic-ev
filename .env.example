# Copy to .env and fill in. .env is git-ignored. Never commit real credentials.
DBT_TARGET=dev                      # dev = DuckDB (local), spark = local Apache Spark, databricks = Databricks

# Databricks (SQL warehouse > Connection details). Free Edition works for this project.
DATABRICKS_HOST=                    # e.g. https://dbc-xxxxxxxx-xxxx.cloud.databricks.com
DATABRICKS_HTTP_PATH=               # e.g. /sql/1.0/warehouses/xxxxxxxxxxxxxxxx
DATABRICKS_TOKEN=                   # personal access token (User settings > Developer > Access tokens)
DATABRICKS_CATALOG=workspace
